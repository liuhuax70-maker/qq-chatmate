# 环境变量示例
# 复制为 .env 后填入真实值。.env 不要提交到 git。

# ── 必填 ──────────────────────────────────────────────────
# DeepSeek API Key（https://platform.deepseek.com/ 申请）
DEEPSEEK_API_KEY=

# OneBot 11 连接令牌（在 Lagrange.OneBot 的配置里设置，两边必须一致）
ONEBOT_ACCESS_TOKEN=

# 机器人自己的 QQ 号（协议端 selfId）
# 建议使用小号，不要用主号
ONEBOT_SELF_ID=100000000

# ── 按需 ──────────────────────────────────────────────────
# Embedding 服务（本地 Ollama 示例）
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=

# 管理接口鉴权令牌（infra.server.authToken）
ADMIN_TOKEN=
